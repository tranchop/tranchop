# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IA (somente servidor — nunca expor ao navegador)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Embeddings (busca semântica). Qualquer endpoint compatível com /v1/embeddings que retorne 1536 dimensões.
# Se vazio, a busca semântica fica desligada e a busca textual continua funcionando.
EMBEDDINGS_API_URL=https://api.openai.com/v1/embeddings
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
